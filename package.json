{
  "name": "@retick/client",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Client for Retick: publish facts, read your own scope by cursor, and read the current state of your entities from a browser, cut to the sources each user may see.",
  "keywords": [
    "retick",
    "event-sourcing",
    "facts",
    "idempotent",
    "cursor",
    "projection",
    "typescript",
    "client",
    "browser",
    "state"
  ],
  "homepage": "https://github.com/neilor/retick-client#readme",
  "bugs": {
    "url": "https://github.com/neilor/retick-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilor/retick-client.git"
  },
  "author": "Neilor Caldeira",
  "engines": {
    "node": ">=18.17.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "default": "./dist/legacy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/portao-de-publicacao.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  }
}
